{
  "name": "@chalidade/security-headers",
  "version": "0.0.0",
  "description": "Preset header keamanan (CSP, HSTS, dan kawan-kawan) untuk Next.js, Vite, dan Express, tanpa dependensi.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
