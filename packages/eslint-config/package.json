{
  "name": "@chalidade/eslint-config",
  "version": "0.0.0",
  "description": "Konfigurasi ESLint flat config bersama: JS + TypeScript, React Hooks opsional, type-aware opsional, aman dipakai bersama Prettier.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.22.0 || ^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
